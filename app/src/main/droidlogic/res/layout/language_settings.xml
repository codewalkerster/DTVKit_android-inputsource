<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:layout_margin="50dp"
    android:gravity="center"
    android:orientation="vertical">

    <!--<ImageView
        android:id="@+id/imageView3"
        android:layout_width="wrap_content"
        android:layout_height="67dp"
        android:src="@drawable/dtvkit" />-->

    <TextView
        android:id="@+id/dvb_search"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/holo_orange_dark"
        android:fontFamily="sans-serif"
        android:gravity="center"
        android:padding="10dp"
        android:text="@string/public_dvb_search"
        android:textSize="@dimen/dvb_search_text_size"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/container"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_margin="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/country_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/country_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsCountry" />

            <Spinner
                android:id="@+id/country_spinner"
                android:layout_width="@dimen/dvb_language_item_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/main_audio_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical" >

            <TextView
                android:id="@+id/main_audio_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsMainAudioLang" />

            <Spinner
                android:id="@+id/main_audio_spinner"
                android:layout_width="@dimen/dvb_language_item_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/assist_audio_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical" >

            <TextView
                android:id="@+id/assist_audio_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsAssistAudioLang" />

            <Spinner
                android:id="@+id/assist_audio_spinner"
                android:layout_width="@dimen/dvb_language_item_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/main_subtitle_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/main_subtitle_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsMainSubtitleLang" />

            <Spinner
                android:id="@+id/main_subtitle_spinner"
                android:layout_width="@dimen/dvb_language_item_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/assist_subtitle_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/assist_subtitle_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsAssistSubtitleLang" />

            <Spinner
                android:id="@+id/assist_subtitle_spinner"
                android:layout_width="@dimen/dvb_language_item_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/teletext_charset_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/teletext_charset_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsTeletextCharset" />

            <Spinner
                android:id="@+id/teletext_charset_spinner"
                android:layout_width="@dimen/dvb_language_item_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/hearing_impaired_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/hearing_impaired_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsHearingImpaired" />

            <Spinner
                android:id="@+id/hearing_impaired_spinner"
                android:layout_width="@dimen/dvb_language_item_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/storage_select_container"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/storage_select_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsStorageSelect" />

            <Spinner
                android:id="@+id/storage_select_spinner"
                android:layout_width="@dimen/dvb_language_item_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical" />

            <Button
                android:id="@+id/storage_refresh"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAllCaps="false"
                android:background="@drawable/selector_button"
                android:elevation="10dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="@string/strSettingsRefresh"/>

            <CheckBox
                android:id="@+id/record_full_frequency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsPvrFullFrequency" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ad_audio"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/ad_audio_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsAdAudio" />

            <CheckBox
                android:id="@+id/ad_audio_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsAdAudio_enable" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/network_update"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/network_update_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsUpdateNetwork" />

            <Button
                android:id="@+id/network_update_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/selector_button"
                android:elevation="10dp"
                android:gravity="center"
                android:textAllCaps="false"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="@string/strSettingsUpdateNetworkUpdate" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/auto_ordering"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/auto_ordering_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsAutoOrdering" />

            <CheckBox
                android:id="@+id/auto_ordering_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsAutoOrdering_enable" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/auto_searching"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/auto_searching_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsAutoSearching" />

            <Button
                android:id="@+id/auto_searching_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@drawable/selector_button"
                android:elevation="10dp"
                android:textAllCaps="false"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="@string/strSettingsAutoSearchingSetting" />
        </LinearLayout>

        <LinearLayout
                android:id="@+id/dummy_frontend_enable"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:orientation="horizontal"
                android:layout_margin="5dp"
                android:layout_weight="1"
                android:gravity="center_vertical">

            <TextView
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/str_dummy_frontend" />

            <CheckBox
                android:id="@+id/dummy_frontend_enable_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strSettingsAutoOrdering_enable" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/factory_settings"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:orientation="horizontal"
            android:layout_margin="5dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/factory_settings_text"
                android:layout_width="@dimen/dvb_language_text_width"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/strFactorySettings" />

            <Button
                android:id="@+id/factory_settings_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAllCaps="false"
                android:background="@drawable/selector_button"
                android:elevation="10dp"
                android:paddingLeft="5dp"
                android:paddingRight="5dp"
                android:text="@string/strSettingsAutoSearchingSetting" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
